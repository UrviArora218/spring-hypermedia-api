package com.baeldung.model;

import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;
import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.GeneratedValue;
import javax.persistence.Id;
import com.fasterxml.jackson.annotation.JsonIgnore;
import com.fasterxml.jackson.annotation.JsonView;

public class BookEqualsTest {

    @Test
    @Tag("valid")
    public void validateEqualityForIdenticalObjects() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        Book book2 = new Book("Author A", "Title A", "ISBN A");

        assertTrue(book1.equals(book2), "Expected identical books to be equal");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityWithDifferentIsbn() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        Book book2 = new Book("Author A", "Title A", "ISBN B");

        assertFalse(book1.equals(book2), "Expected books with different ISBNs to be unequal");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityWithDifferentAuthor() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        Book book2 = new Book("Author B", "Title A", "ISBN A");

        assertFalse(book1.equals(book2), "Expected books with different authors to be unequal");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityWithDifferentTitle() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        Book book2 = new Book("Author A", "Title B", "ISBN A");

        assertFalse(book1.equals(book2), "Expected books with different titles to be unequal");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityWhenObjectIsNull() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        Book book2 = null;

        assertFalse(book1.equals(book2), "Expected comparison with null to return false");
    }

    @Test
    @Tag("valid")
    public void validateEqualityWhenSameInstance() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");

        assertTrue(book1.equals(book1), "Expected comparison with same instance to be true");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityForDifferentTypes() {
        Book book1 = new Book("Author A", "Title A", "ISBN A");
        String otherObject = "Some String";

        assertFalse(book1.equals(otherObject), "Expected comparison with different types to return false");
    }

    @Test
    @Tag("valid")
    public void validateEqualityWhenAllFieldsNull() {
        Book book1 = new Book(null, null, null);
        Book book2 = new Book(null, null, null);

        assertTrue(book1.equals(book2), "Expected books with all fields null to be equal");
    }

    @Test
    @Tag("invalid")
    public void validateInequalityWithPartiallyNullFields() {
        Book book1 = new Book("Author A", null, "ISBN A");
        Book book2 = new Book("Author A", "Title A", null);

        assertFalse(book1.equals(book2), "Expected books with partially null fields to be unequal");
    }

    @Test
    @Tag("invalid")
    public void validateKeyFieldBasedInequality() {
        Book book1 = new Book("Author A", "Title A", "12345");
        Book book2 = new Book("Author A", "Title A", "67890");

        assertFalse(book1.equals(book2), "Expected books with different key fields (ISBN) to be unequal");
    }
}
