        int actualHashCode = cart.hashCode();
        
        // Assert
        int booksHashCode = cart.getBooks().hashCode(); // Hash code for an empty list
        int expectedHashCode = 31 * (31 * 1 + booksHashCode) + 1231;
        assertEquals((Integer) expectedHashCode, (Integer) actualHashCode);
    }
    
