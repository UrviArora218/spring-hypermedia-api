package com.baeldung.model;import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mockito;
import java.util.List;
import java.util.ArrayList;
import static org.junit.Assert.assertEquals;
import static org.junit.Assert.assertThrows;
import static org.mockito.Mockito.mock;

public class CartAddTest {
    @Test
    @Category(Categories.invalid.class)
    public void addBookToEmptyNullList() {
        // Arrange
        Cart cart = new Cart();
        cart.setPurchased(false); // Validating cart is not yet purchased
        Book book = mock(Book.class);
        Mockito.when(book.getTitle()).thenReturn("Valid Title");
        Mockito.when(book.getIsbn()).thenReturn("123-VALID");
        Mockito.when(book.getAuthor()).thenReturn("Valid Author");
        
        // Act & Assert
        assertThrows(NullPointerException.class, () -> cart.add(null));
        // Comment: The above test validates behavior for null input; the add method relies on "books" initialization, ensured by the constructor.
    }
    @Test
    @Category(Categories.boundary.class)
    public void addSingleValidBook() {
        // Arrange
        Cart cart = new Cart(); // Ensure the cart books list initializes with the constructor.
        cart.setPurchased(false); // Validating the cart is not yet purchased
        Book book = new Book("Valid Author", "Valid Title", "123-VALID");
        // Act
        cart.add(book);
        // Assert
        List<Book> books = cart.getBooks(); // Assuming the getter is present in Cart to fetch books.
        assertEquals(1, books.size());
        Book addedBook = books.get(0);
        assertEquals("Valid Title", addedBook.getTitle());
        assertEquals("123-VALID", addedBook.getIsbn());
        assertEquals("Valid Author", addedBook.getAuthor());
    }
}