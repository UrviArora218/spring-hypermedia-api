package com.baeldung.web.controller;import static org.mockito.Mockito.*;
import static org.junit.Assert.*;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import com.baeldung.model.Book;
import com.baeldung.model.Cart;
import com.baeldung.persistence.BookRepository;
import com.baeldung.web.error.Checks;
import com.baeldung.web.resource.BookResource;
import com.baeldung.web.resource.CartResource;
import org.springframework.beans.factory.InitializingBean;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;
import com.baeldung.web.resource.NewBookResource;

public class CartControllerAddBookToCartTest {
    @Mock
    private BookRepository bookRepo;
    @InjectMocks
    private CartController cartController;
    public CartControllerAddBookToCartTest() {
        MockitoAnnotations.initMocks(this);
    }
    @Test
    @Category(Categories.valid.class)
    public void addValidBookToCartSuccessfully() {
        // Arrange
        Cart cart = new Cart();
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Correct initialization of Book object
        when(bookRepo.findByIsbn(anyString())).thenReturn(mockBook);
        BookResource bookResource = new BookResource();
        bookResource.setBook(mockBook); // Correct initialization of BookResource object
        cartController.afterPropertiesSet(); // Initialize CartController
        // Act
        CartResource cartResource = cartController.addBookToCart(bookResource);
        // Assert
        assertNotNull((CartResource) cartResource);
        assertEquals(1, cartResource.getBooks().size());
        assertTrue(cartResource.getBooks().contains(mockBook));
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void handleMissingBookInRepository() {
        // Arrange
        when(bookRepo.findByIsbn(anyString())).thenReturn(null);
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Proper initialization of Book object
        BookResource bookResource = new BookResource();
        bookResource.setBook(mockBook); // Proper initialization of BookResource object
        // Act
        cartController.addBookToCart(bookResource);
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void handleNullBookResourceParameter() {
        // Act
        cartController.addBookToCart(null);
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void handleNullIsbnInBookResource() {
        // Arrange
        Book book = new Book();
        book.setIsbn(null); // Proper initialization with null ISBN
        BookResource bookResource = new BookResource();
        bookResource.setBook(book); // Proper initialization of BookResource object
        // Act
        cartController.addBookToCart(bookResource);
    }
    @Test
    @Category(Categories.boundary.class)
    public void addDuplicateBookToCart() {
        // Arrange
        Cart cart = new Cart();
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Correct initialization of Book object
        cart.getBooks().add(mockBook); // Adding the duplicate book initially
        when(bookRepo.findByIsbn(anyString())).thenReturn(mockBook);
        BookResource bookResource = new BookResource();
        bookResource.setBook(mockBook); // Correct initialization of BookResource object
        cartController.afterPropertiesSet(); // Initialize CartController
        // Act
        CartResource cartResource = cartController.addBookToCart(bookResource);
        // Assert
        assertNotNull((CartResource) cartResource);
        assertEquals(2, cartResource.getBooks().size());
        assertTrue(cartResource.getBooks().contains(mockBook)); // Validating duplicates are allowed
    }
    @Test
    @Category(Categories.valid.class)
    public void initializeCartAndAddFirstBook() {
        // Arrange
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Proper Book initialization
        when(bookRepo.findByIsbn(anyString())).thenReturn(mockBook);
        BookResource bookResource = new BookResource();
        bookResource.setBook(mockBook); // Proper BookResource initialization
        cartController.afterPropertiesSet(); // Initialize CartController
        // Act
        CartResource cartResource = cartController.addBookToCart(bookResource);
        // Assert
        assertNotNull((CartResource) cartResource);
        assertEquals(1, cartResource.getBooks().size());
        assertTrue(cartResource.getBooks().contains(mockBook));
    }
    @Test
    @Category(Categories.boundary.class)
    public void addBookWithWhitespaceInIsbn() {
        // Arrange
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Proper Book initialization
        when(bookRepo.findByIsbn(eq("12345"))).thenReturn(mockBook);
        BookResource bookResource = new BookResource();
        Book bookWithWhitespace = new Book();
        bookWithWhitespace.setIsbn(" 12345 "); // Proper initialization with whitespace in ISBN
        bookResource.setBook(bookWithWhitespace);
        cartController.afterPropertiesSet(); // Initialize CartController
        // Act
        CartResource cartResource = cartController.addBookToCart(bookResource);
        // Assert
        assertNotNull((CartResource) cartResource);
        assertEquals(1, cartResource.getBooks().size());
        assertTrue(cartResource.getBooks().contains(mockBook));
    }
    @Test(expected = RuntimeException.class)
    @Category(Categories.integration.class)
    public void handleRepositoryInteractionException() {
        // Arrange
        when(bookRepo.findByIsbn(anyString())).thenThrow(new RuntimeException("Database error"));
        Book mockBook = new Book();
        mockBook.setIsbn("12345"); // Proper Book initialization
        BookResource bookResource = new BookResource();
        bookResource.setBook(mockBook); // Correct initialization of BookResource object
        // Act
