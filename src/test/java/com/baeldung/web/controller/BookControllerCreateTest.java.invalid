package com.baeldung.web.controller;import com.baeldung.model.Book;
import com.baeldung.web.resource.BookResource;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import org.mockito.Mockito;
import static org.mockito.Mockito.*;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import java.util.List;
import java.util.stream.Collectors;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.PathVariable;
import org.springframework.web.bind.annotation.RequestBody;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RequestMethod;
import org.springframework.web.bind.annotation.RestController;
import com.baeldung.model.BookView;
import com.baeldung.persistence.BookRepository;
import com.baeldung.web.error.Checks;
import com.fasterxml.jackson.annotation.JsonView;

public class BookControllerCreateTest {
    private BookRepository mockRepo = mock(BookRepository.class);
    private BookController createController() {
        BookController controller = new BookController();
        controller.repo = mockRepo; // Assigning mocked repository since the actual constructor does not accept arguments.
        return controller;
    }
    @Test
    @Category(Categories.valid.class)
    public void createSavesNewBookSuccessfully() {
        // Arrange
        BookController controller = createController();
        Book mockBook = new Book(); // Create mock Book instance
        mockBook.setId(1L);
        mockBook.setTitle("Test Title");
        mockBook.setAuthor("Test Author");
        mockBook.setIsbn("1234567890");
        BookResource mockResource = mock(BookResource.class);
        when(mockResource.getBook()).thenReturn(mockBook);
        
        // Act
        controller.create(mockResource);
        
        // Assert
        verify(mockRepo, times(1)).save(mockBook);
    }
    @Test(expected = NullPointerException.class)
    @Category(Categories.invalid.class)
    public void createThrowsErrorForNullBookResource() {
        // Arrange
        BookController controller = createController();
        
        // Act
        controller.create(null);
    }
    @Test
    @Category(Categories.boundary.class)
    public void createHandlesSavingEmptyBookObject() {
        // Arrange
        BookController controller = createController();
        Book emptyBook = new Book(); // Empty book
        BookResource mockResource = mock(BookResource.class);
        when(mockResource.getBook()).thenReturn(emptyBook);
        
        // Act
        controller.create(mockResource);
        
        // Assert
        verify(mockRepo, times(1)).save(emptyBook);
    }
    @Test
    @Category(Categories.integration.class)
    public void createInvokesRepoSaveCorrectly() {
        // Arrange
        BookController controller = createController();
        Book validBook = new Book();
        validBook.setTitle("Valid Book Title");
        validBook.setAuthor("Valid Author");
        validBook.setIsbn("9876543210");
        BookResource validResource = mock(BookResource.class);
        when(validResource.getBook()).thenReturn(validBook);
        
        // Act
        controller.create(validResource);
        
        // Assert
        verify(mockRepo, times(1)).save(validBook);
    }
    @Test
    @Category(Categories.boundary.class)
    public void createHandlesConcurrentCallsToRepoSave() throws InterruptedException {
        // Arrange
        BookController controller = createController();
        Book validBook1 = new Book();
        validBook1.setTitle("Concurrent Book 1");
        validBook1.setAuthor("Author 1");
        validBook1.setIsbn("1111111111");
        Book validBook2 = new Book();
        validBook2.setTitle("Concurrent Book 2");
        validBook2.setAuthor("Author 2");
        validBook2.setIsbn("2222222222");
        BookResource resource1 = mock(BookResource.class);
        BookResource resource2 = mock(BookResource.class);
        when(resource1.getBook()).thenReturn(validBook1);
        when(resource2.getBook()).thenReturn(validBook2);
        
        // Act
        Thread thread1 = new Thread(() -> controller.create(resource1));
        Thread thread2 = new Thread(() -> controller.create(resource2));
        thread1.start();
        thread2.start();
        thread1.join();
        thread2.join();
        
        // Assert
        verify(mockRepo, times(1)).save(validBook1);
        verify(mockRepo, times(1)).save(validBook2);
    }
    @Test(expected = RuntimeException.class)
    @Category(Categories.boundary.class)
    public void createHandlesRepoSaveExceptionsGracefully() {
        // Arrange
        BookController controller = createController();
        Book validBook = new Book();
        validBook.setTitle("Exception Book Title");
        validBook.setAuthor("Exception Author");
        validBook.setIsbn("3333333333");
        BookResource mockResource = mock(BookResource.class);
        when(mockResource.getBook()).thenReturn(validBook);
        doThrow(new RuntimeException()).when(mockRepo).save(validBook);
        
        // Act
        controller.create(mockResource);
    }
    @Test(expected = IllegalArgumentException.class)
    @Category(Categories.invalid.class)
    public void createFailsForInvalidInputType() {
        // Arrange
        BookController controller = createController();
        
        // Act
        controller.create((BookResource) new Object()); // Invalid input type explicitly casted
    }
    @Test
    @Category(Categories.invalid.class)
    public void createFailsForIncompleteBookProperties() {
        // Arrange
        BookController controller = createController();
        Book incompleteBook = new Book(); // Create book with missing required properties
        incompleteBook.setTitle("Missing Author and ISBN");
        BookResource mockResource = mock(BookResource.class);
        when(mockResource.getBook()).thenReturn(incompleteBook);
        
        // Act
        controller.create(mockResource);
        
        // Assert
        verify(mockRepo, times(1)).save(incompleteBook);
    }
}