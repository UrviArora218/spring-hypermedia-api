            }
        }
    };
    @Test
    @Category(Categories.valid.class)
    public void saveNewBookSuccessfully() {
        NewBookResource newBookResource = mock(NewBookResource.class);
        Book mockBook = mock(Book.class);
        when(newBookResource.getBook()).thenReturn(mockBook);
        controller.create(newBookResource);
        verify(mockedRepo, times(1)).save(mockBook);
    }
