        NewBookResource bookResource2 = mock(NewBookResource.class);
        Book book1 = mock(Book.class);
        Book book2 = mock(Book.class);
        when(bookResource1.getBook()).thenReturn(book1);
        when(bookResource2.getBook()).thenReturn(book2);
        Thread thread1 = new Thread(() -> controller.create(bookResource1));
        Thread thread2 = new Thread(() -> controller.create(bookResource2));
        thread1.start();
        thread2.start();
        thread1.join();
        thread2.join();
        verify(mockedRepo, times(1)).save(book1);
