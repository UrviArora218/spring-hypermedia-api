    @Test
    @Category(Categories.integration.class)
    public void clearYourCartWithConcurrentModification() throws InterruptedException {
        // Arrange
        Book mockBook = mock(Book.class);
        Cart cart = new Cart();
        cart.getBooks().add(mockBook);
        cart.setPurchased(true);
        setCartInController(cartController, cart);
        Runnable clearTask = () -> cartController.clearYourCart();
        Thread thread1 = new Thread(clearTask);
        Thread thread2 = new Thread(clearTask);
        // Act
        thread1.start();
        thread2.start();
        thread1.join();
        thread2.join();
        // Assert
        Cart modifiedCart = (Cart) getCartInController(cartController);
        assertNotNull((Cart) modifiedCart);
        assertEquals(Collections.emptyList(), (List<Book>) modifiedCart.getBooks());
        assertFalse((boolean) modifiedCart.isPurchased());
    }
    @Test
