        }
        setCartInController(cartController, cart);
        // Act
        long startTime = System.currentTimeMillis();
        CartResource result = cartController.clearYourCart();
        long endTime = System.currentTimeMillis();
        // Assert
        assertNotNull((CartResource) result);
        assertEquals(Collections.emptyList(), (List<Book>) result.getBooks());
        assertFalse((boolean) result.isPurchased());
        assertTrue("Method execution took too long", (endTime - startTime) < 1000); // Validate performance
    }
    // Utility method for setting private field 'cart'
    private void setCartInController(CartController controller, Cart cart) {
        try {
            java.lang.reflect.Field field = CartController.class.getDeclaredField("cart");
            field.setAccessible(true);
            field.set(controller, cart);
        } catch (NoSuchFieldException | IllegalAccessException e) {
            throw new RuntimeException(e);
        }
    }
    // Utility method for getting private field 'cart'
    private Cart getCartInController(CartController controller) {
        try {
            java.lang.reflect.Field field = CartController.class.getDeclaredField("cart");
            field.setAccessible(true);
            return (Cart) field.get(controller);
        } catch (NoSuchFieldException | IllegalAccessException e) {
