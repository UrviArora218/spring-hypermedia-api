public class CartControllerClearYourCartTest {
    @Mock
    private BookRepository bookRepo;
    @InjectMocks
    private CartController cartController;
    @Test
    @Category(Categories.valid.class)
    public void clearYourCartSuccessfully() {
        // Arrange
        Book mockBook1 = mock(Book.class);
        Book mockBook2 = mock(Book.class);
        Cart cart = new Cart();
        cart.getBooks().addAll(Arrays.asList(mockBook1, mockBook2));
        cartController.afterPropertiesSet(); // Ensuring initialization
        // Set cart via reflection as 'cart' has private access in CartController
        setCartInController(cartController, cart);
        // Act
        CartResource result = cartController.clearYourCart();
        // Assert
        assertNotNull((CartResource) result);
        assertEquals(Collections.emptyList(), (List<Book>) result.getBooks());
        assertFalse((boolean) result.isPurchased());
    }
    @Test
    @Category(Categories.boundary.class)
    public void clearYourCartWhenEmpty() {
        // Arrange
        Cart cart = new Cart(); // Empty cart
        cartController.afterPropertiesSet(); // Ensuring initialization
        setCartInController(cartController, cart);
        // Act
        CartResource result = cartController.clearYourCart();
        // Assert
        assertNotNull((CartResource) result);
        assertEquals(Collections.emptyList(), (List<Book>) result.getBooks());
        assertFalse((boolean) result.isPurchased());
    }
    @Test
    @Category(Categories.integration.class)
    public void initializeCartAndClearYourCart() {
        // Arrange
        cartController.afterPropertiesSet(); // Explicit initialization
        Cart cart = new Cart();
        setCartInController(cartController, cart);
        // Act
        CartResource result = cartController.clearYourCart();
        // Assert
        assertNotNull((CartResource) result);
        assertNotNull((Cart) getCartInController(cartController));
        assertEquals(Collections.emptyList(), (List<Book>) result.getBooks());
        assertFalse((boolean) result.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void verifyReturnedCartResourceAfterClearYourCart() {
        // Arrange
        Book mockBook = mock(Book.class);
        Cart cart = new Cart();
        cart.getBooks().add(mockBook);
        cart.setPurchased(true);
        setCartInController(cartController, cart);
        // Act
        CartResource result = cartController.clearYourCart();
        // Assert
        assertNotNull((CartResource) result);
        assertEquals(Collections.emptyList(), (List<Book>) result.getBooks());
        assertFalse((boolean) result.isPurchased());
    }
    @Test
    @Category(Categories.valid.class)
    public void resetCartAfterPurchaseWithClearYourCart() {
        // Arrange
        Book mockBook = mock(Book.class);
        Cart cart = new Cart();
        cart.getBooks().add(mockBook);
        cart.setPurchased(true);
        setCartInController(cartController, cart);
        // Act
        CartResource result = cartController.clearYourCart();
        // Assert
        assertNotNull((CartResource) result);
        assertFalse((boolean) result.isPurchased());
    }
    @Test
    @Category(Categories.integration.class)
    public void ensureNoUsageOfBookRepositoryInClearYourCart() {
        // Arrange
        Book mockBook = mock(Book.class);
        Cart cart = new Cart();
        cart.getBooks().add(mockBook);
        setCartInController(cartController, cart);
