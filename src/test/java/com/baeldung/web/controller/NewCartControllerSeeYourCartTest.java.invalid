import com.baeldung.web.resource.CartResource;
import jersey.repackaged.com.google.common.collect.Lists;

// No changes made to imports as they are correct.
@RunWith(MockitoJUnitRunner.class)
public class NewCartControllerSeeYourCartTest {
    @Mock
    private BookRepository bookRepo;
    @InjectMocks
    private NewCartController controller;
    @Test
    @Category(Categories.valid.class)
    public void seeYourCartReturnsValidNewCartResource() {
        // Arrange
        Mockito.when(controller.initializeBooksInCart()).thenReturn(Lists.newArrayList());
        controller.books = Lists.newArrayList(); // Ensures books list is initialized
        controller.cartPurchased = false;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertNotNull(cartResource);
        assertEquals(0, (int) cartResource.getBooks().size()); // Type casting to match method signature
        assertFalse(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.boundary.class)
    public void seeYourCartInitializesBooksList() {
        // Arrange
        controller.books = null;
        controller.cartPurchased = false;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertNotNull(cartResource.getBooks());
        assertEquals(0, (int) cartResource.getBooks().size()); // Type casting to match method signature
    }
    @Test
    @Category(Categories.valid.class)
    public void seeYourCartPreservesExistingBooks() {
        // Arrange
        Book book1 = new Book();
        book1.setIsbn("1234"); // Valid constructor usage
        Book book2 = new Book();
        book2.setIsbn("5678"); // Valid constructor usage
        List<Book> existingBooks = Lists.newArrayList(book1, book2);
        controller.books = existingBooks;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertNotNull(cartResource.getBooks());
        assertEquals(existingBooks, cartResource.getBooks());
    }
    @Test
    @Category(Categories.valid.class)
    public void seeYourCartGeneratesValidBookLinks() {
        // Arrange
        Book book1 = new Book();
        book1.setIsbn("1234"); // Valid constructor usage
        Book book2 = new Book();
        book2.setIsbn("5678"); // Valid constructor usage
        controller.books = Lists.newArrayList(book1, book2);
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        List<Link> links = cartResource.getBooks().getLinks(); // Ensures valid usage of attributes and methods
        assertEquals((int) controller.books.size(), (int) links.size()); // Type casting to match method signature
        for (int i = 0; i < controller.books.size(); i++) {
            assertTrue(links.get(i).getHref().contains(controller.books.get(i).getIsbn()));
        }
    }
    @Test
    @Category(Categories.valid.class)
    public void seeYourCartReturnsCorrectCartPurchasedState() {
        // Arrange
        controller.cartPurchased = true;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertTrue(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.boundary.class)
    public void seeYourCartHandlesEmptyCart() {
        // Arrange
        controller.books = null;
        controller.cartPurchased = false;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertNotNull(cartResource);
        assertEquals(0, (int) cartResource.getBooks().size()); // Type casting to match method signature
        assertFalse(cartResource.isPurchased());
    }
    @Test
    @Category(Categories.boundary.class)
    public void seeYourCartHandlesNullBooksAndLinks() {
        // Arrange
        controller.books = null;
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertNotNull(cartResource);
        assertNotNull(cartResource.getBooks());
        assertEquals(0, (int) cartResource.getBooks().size()); // Type casting to match method signature
    }
    @Test
    @Category(Categories.integration.class)
    public void seeYourCartProducesConsistentOutput() {
        // Arrange
        Book book1 = new Book();
        book1.setIsbn("1234"); // Valid constructor usage
        Book book2 = new Book();
        book2.setIsbn("5678"); // Valid constructor usage
        controller.books = Lists.newArrayList(book1, book2);
        controller.cartPurchased = true;
        // Act
        NewCartResource cartResource1 = controller.seeYourCart();
        NewCartResource cartResource2 = controller.seeYourCart();
        // Assert
        assertEquals(cartResource1, cartResource2);
    }
    @Test
    @Category(Categories.boundary.class)
    public void seeYourCartDefaultCartPurchasedState() {
        // Arrange
        controller.cartPurchased = false; // Ensures "cartPurchased" starts from false state.
        // Act
        NewCartResource cartResource = controller.seeYourCart();
        // Assert
        assertFalse(cartResource.isPurchased());
    }
