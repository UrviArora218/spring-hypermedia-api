public class NewCartControllerBuyTest {
    private NewCartController controller = new NewCartController(); // Assuming no-arg constructor exists.
    @Category(Categories.valid.class)
    @Test
    public void markCartAsPurchasedIfTheCartIsPurchased() {
        // Arrange
        CartResource theCart = new CartResource();
        theCart.setPurchased(true);
        
        controller.initializeBooksInCart().clear();
        
        // Act
        NewCartResource result = controller.buy(theCart);
        
        // Assert
        assertTrue((boolean) result.isPurchased());
    }
    @Category(Categories.invalid.class)
    @Test
    public void doNotMarkCartAsPurchasedIfTheCartIsNotPurchased() {
        // Arrange
        CartResource theCart = new CartResource();
        theCart.setPurchased(false);
        
        controller.initializeBooksInCart().clear();
        
        // Act
        NewCartResource result = controller.buy(theCart);
        
        // Assert
        assertFalse((boolean) result.isPurchased());
    }
    @Category(Categories.boundary.class)
    @Test
    public void ensureTheCartCanBePurchasedWhenBooksListIsEmpty() {
        // Arrange
        CartResource theCart = new CartResource();
        theCart.setPurchased(true);
        
        controller.initializeBooksInCart().clear();
        
        // Act
        NewCartResource result = controller.buy(theCart);
        
        // Assert
        assertTrue((boolean) result.isPurchased());
        assertNotNull(result.getLinks()); // Ensure links are added even with empty books.
    }
    @Category(Categories.boundary.class)
    @Test
    public void ensureTheCartCanBePurchasedWhenBooksListIsNotEmpty() {
        // Arrange
        CartResource theCart = new CartResource();
        theCart.setPurchased(true);
        
        controller.initializeBooksInCart().add(new Book("978-3-16-148410-0", "Sample Book")); 
        
        // Act
        NewCartResource result = controller.buy(theCart);
        
        // Assert
        assertTrue((boolean) result.isPurchased());
        assertFalse((boolean) result.getLinks().isEmpty()); 
    }
    @Category(Categories.integration.class)
    @Test
    public void ensureLinkIsGeneratedCorrectly() {
        // Arrange
        CartResource theCart = new CartResource();
        theCart.setPurchased(true);
        
        Book book = new Book("978-3-16-148410-0", "Sample Book");
        controller.initializeBooksInCart().add(book);
        
        // Act
        NewCartResource result = controller.buy(theCart);
        
        // Assert
        List<Link> bookLinks = result.getLinks();
        assertNotNull(bookLinks);
        assertFalse((boolean) bookLinks.isEmpty());
