package com.baeldung.web.resource;import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;
import java.util.List;
import org.springframework.hateoas.Resources;
import org.springframework.hateoas.Link;
import com.baeldung.model.Book;
import com.baeldung.web.controller.NewCartController;
import org.junit.Test;
import org.junit.experimental.categories.Category;
import static org.junit.Assert.*;
import jersey.repackage com.baeldung.web.resource;
import org.springframework.hateoas.ResourceSupport;
import jersey.repackaged.com.google.common.collect.Lists;

public class NewCartResourceGetBooksTest {
    @Test
    @Category(Categories.valid.class)
    public void verifyGetBooksReturnsBooks() {
        // Arrange
        List<Book> bookList = Lists.newArrayList(
            new Book(1L, "978-1234567890", "Author1", "Title1", "Synopsis1", "English"), 
            new Book(2L, "978-0987654321", "Author2", "Title2", "Synopsis2", "English")
        );
        NewCartResource resource = new NewCartResource(bookList, true);
        // Act
        Resources<Book> actualBooks = resource.getBooks();
        // Assert
        assertNotNull(actualBooks);
        assertEquals(bookList, actualBooks.getContent());
    }
    @Test
    @Category(Categories.invalid.class)
    public void verifyGetBooksReturnsNullWhenUninitialized() {
        // Arrange
        NewCartResource resource = new NewCartResource(null, false);
        // Act
        Resources<Book> actualBooks = resource.getBooks();
        // Assert
        assertNull("Books should be null when uninitialized.", actualBooks);
    }
    @Test
    @Category(Categories.boundary.class)
    public void verifyGetBooksReturnsEmptyResourceBooks() {
        // Arrange
        List<Book> emptyBookList = Lists.newArrayList();
        NewCartResource resource = new NewCartResource(emptyBookList, false);
        // Act
        Resources<Book> actualBooks = resource.getBooks();
        // Assert
        assertNotNull(actualBooks);
        assertTrue("Books content should be empty for an empty list.", actualBooks.getContent().isEmpty());
    }
    @Test
    @Category(Categories.integration.class)
    public void validateGetBooksFieldIntegrationCompatibility() {
        // Arrange
        List<Book> bookList = Lists.newArrayList(
            new Book(3L, "978-1122334455", "Author3", "Title3", "Synopsis3", "French")
        );
        List<Link> links = Lists.newArrayList(
            linkTo(methodOn(NewCartController.class).seeYourCart()).withSelfRel()
        );
        NewCartResource resource = new NewCartResource(bookList, links, true);
        // Act
        Resources<Book> actualBooks = resource.getBooks();
        // Assert
        assertNotNull(actualBooks);
        assertEquals(bookList, actualBooks.getContent());
        assertFalse("Links should not be empty for linked resources.", actualBooks.getLinks().isEmpty());
    }
}