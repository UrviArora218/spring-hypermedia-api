package com.baeldung.web.resource;

import static org.springframework.hateoas.mvc.ControllerLinkBuilder.linkTo;
import static org.springframework.hateoas.mvc.ControllerLinkBuilder.methodOn;

import java.util.List;

import org.springframework.hateoas.Resources;
import org.springframework.hateoas.Link;

import com.baeldung.model.Book;
import com.baeldung.web.controller.NewCartController;
import org.junit.Test;
import org.junit.experimental.categories.Category;

import static org.junit.Assert.*;
import jersey.repackaged.com.google.common.collect.Lists;

public class NewCartResourceGetBooksTest {

    @Test
    @Category(Categories.valid.class)
    public void verifyGetBooksReturnsBooks() {
        // Arrange
        List<Book> initializedBookList = Lists.newArrayList(
            new Book(1L, "978-1234567890", "Author1", "Title1", "Synopsis1", "English"), 
            new Book(2L, "978-0987654321", "Author2", "Title2", "Synopsis2", "English")
        );
        NewCartResource initializedResource = new NewCartResource(initializedBookList, true);

        // Act
        Resources<Book> actualBooksResource = initializedResource.getBooks();

        // Assert
        assertNotNull("The Resource containing books should not be null.", actualBooksResource);
        assertEquals("The content of the book list should match the initialized list.", initializedBookList, actualBooksResource.getContent());
    }

    @Test
    @Category(Categories.invalid.class)
    public void verifyGetBooksReturnsNullWhenUninitialized() {
        // Arrange
        NewCartResource uninitializedResource = new NewCartResource(null, false);

        // Act
        Resources<Book> actualBooksResource = uninitializedResource.getBooks();

        // Assert
        assertNull("Books should be null when the resource is uninitialized.", actualBooksResource);
    }

    @Test
    @Category(Categories.boundary.class)
    public void verifyGetBooksReturnsEmptyResourceBooks() {
        // Arrange
        List<Book> emptyBookList = Lists.newArrayList();
        NewCartResource emptyResource = new NewCartResource(emptyBookList, false);

        // Act
        Resources<Book> actualBooksResource = emptyResource.getBooks();

        // Assert
        assertNotNull("The Resource containing books should not be null even for an empty list.", actualBooksResource);
        assertTrue("Books content should be empty for an empty book list.", actualBooksResource.getContent().isEmpty());
    }

    @Test
    @Category(Categories.integration.class)
    public void validateGetBooksFieldIntegrationCompatibility() {
        // Arrange
        List<Book> linkedBookList = Lists.newArrayList(
            new Book(3L, "978-1122334455", "Author3", "Title3", "Synopsis3", "French")
        );
        List<Link> cartLinks = Lists.newArrayList(
            linkTo(methodOn(NewCartController.class).seeYourCart()).withSelfRel()
        );
        NewCartResource linkedResource = new NewCartResource(linkedBookList, cartLinks, true);

        // Act
        Resources<Book> actualBooksResource = linkedResource.getBooks();

        // Assert
        assertNotNull("The Resource containing books should not be null for linked resources.", actualBooksResource);
        assertEquals("The content of the book list should match the linked list.", linkedBookList, actualBooksResource.getContent());
        assertFalse("Links should not be empty for resources with links.", actualBooksResource.getLinks().isEmpty());
    }
}
